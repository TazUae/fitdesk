# ─────────────────────────────────────────────────────────────────────────────
# FitDesk — Environment Variables
#
# Copy this file to .env and fill in every value before running the app.
# NEVER commit .env to version control.
#
# Generate a random secret: openssl rand -base64 32
# ─────────────────────────────────────────────────────────────────────────────

# ─── App ─────────────────────────────────────────────────────────────────────

# Public URL of this deployment — used in auth redirects and email links.
# Local:      http://localhost:3000
# Production: https://fitdesk.yourdomain.com
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Client-side API base for same-origin requests. Keep relative in all envs.
NEXT_PUBLIC_API_URL=/api

# ─── Feature flags ────────────────────────────────────────────────────────────
# Set to 1 to enable the Pop-and-Split Goal Workspace in Add Client (Phase 4D).
# Unset or 0 = legacy GoalAccordion (default, safe for production).
# NEXT_PUBLIC_GOAL_WORKSPACE=1

# Set to '1' to enable the local client_index read model for the Client
# Directory. Unset = always reads live ERP Customers (default, safe).
# Automatically falls back to ERP on any local-read error or empty local table.
# FITDESK_CLIENT_DIRECTORY_LOCAL_READ=1

# Optional comma-separated tenant allowlist for the flag above. If set, only
# these tenant IDs use the local read; every other tenant stays on ERP
# regardless of the flag. Leave unset to apply the flag to all tenants.
# FITDESK_CLIENT_DIRECTORY_LOCAL_TENANTS=tenant-a,tenant-b

# Optional: shown in the /api/health response for deployment identification.
APP_VERSION=1.0.0

# ─── Scheduling ───────────────────────────────────────────────────────────────
# IANA timezone used as a fallback when a trainer's ERP Trainer Settings doc
# has no timezone set, or the ERP fetch fails. Defaults to 'UTC' if unset.
# TRAINER_DEFAULT_TIMEZONE=UTC

# ─── Pilot mode (safety gates) ─────────────────────────────────────────────────
# PILOT_MODE gates outgoing WhatsApp sends behind a test-phone allowlist so
# real clients are never messaged during a pilot. Unset/false = normal sending
# (default — use only once fully out of pilot). Set to 'true' or '1' to enable.
# PILOT_MODE=true

# Required when PILOT_MODE is enabled. Sends are blocked (fail-closed) unless
# the destination matches this exact number or a prefix below.
# Comma-separated E.164 digits, no leading +. Example: 971501234567
FITDESK_ALLOWED_TEST_PHONE=

# Comma-separated allowed phone-number prefixes (same digit format as above).
# Example: 971501,971502
FITDESK_ALLOWED_TEST_PHONE_PREFIXES=

# Safety gate for live/external payment provider calls. Must stay unset/false
# unless external payments have been explicitly approved — do not enable
# without sign-off. Set to 'true' or '1' only once approved.
# PILOT_ALLOW_EXTERNAL_PAYMENTS=true

# ─── Better Auth ──────────────────────────────────────────────────────────────

# Strong random secret — must be at least 32 characters.
# Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Must match NEXT_PUBLIC_APP_URL exactly (no trailing slash).
BETTER_AUTH_URL=http://localhost:3000
# Internal app URL used by server-side middleware/auth checks.
# In Dokploy/containers, keep this on local HTTP to avoid TLS loopback issues.
INTERNAL_API_URL=http://127.0.0.1:3000
# Legacy/alternate name for INTERNAL_API_URL — only used as a fallback if
# INTERNAL_API_URL is unset. Same purpose and value. If both are unset,
# middleware defaults to http://127.0.0.1:3000.
# BETTER_AUTH_INTERNAL_URL=http://127.0.0.1:3000

# ─── Google OAuth (optional) ─────────────────────────────────────────────────
# Leave blank to disable Google sign-in. Both values required to enable it.
# Console: https://console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Auth Database (SQLite via LibSQL) ───────────────────────────────────────
# Local development:
#   DATABASE_URL=file:./auth.db
#
# Docker deployment (uses the db_data volume at /app/data):
#   DATABASE_URL=file:/app/data/auth.db
#
# Production with Turso (recommended for multi-instance):
#   DATABASE_URL=libsql://your-db-name.turso.io
#   DATABASE_AUTH_TOKEN=<your-turso-token>
DATABASE_URL=file:./auth.db
DATABASE_AUTH_TOKEN=

# ─── ERP Proxy / Control Plane ───────────────────────────────────────────────
# FitDesk never stores ERPNext/Frappe credentials.
# All ERP I/O goes through the Control Plane ERP proxy using a short-lived tenant JWT.
CONTROL_PLANE_URL=http://localhost:4000

# Shared signing secret used by FitDesk to sign tenant JWTs for the Control Plane proxy.
# Must match the Control Plane verifier secret and be at least 32 characters.
FITDESK_JWT_SECRET=

# Optional server-side Control Plane API key for Control Plane helper endpoints.
# Do not expose this to the browser.
CONTROL_PLANE_API_KEY=

# ─── Evolution API (WhatsApp) ─────────────────────────────────────────────────
# Base URL of your Evolution API instance — no trailing slash.
EVOLUTION_API_URL=https://your-evolution.example.com

# API key set in your Evolution API config.
EVOLUTION_API_KEY=

# The Evolution instance name (WhatsApp connection identifier).
# Must match the instance created in the Evolution API dashboard.
EVOLUTION_INSTANCE_NAME=fitdesk

# ─── Whish Payments ──────────────────────────────────────────────────────────
# Leave blank to disable Whish. Cash and bank transfer always remain available.
# Contact Whish Money for merchant API credentials.
WHISH_API_URL=
WHISH_API_KEY=
WHISH_MERCHANT_ID=

# ─── AI Message Generation (Claude) ──────────────────────────────────────────
# Optional. When set, the message composer uses Claude to generate drafts.
# Without this key, high-quality professional templates are used instead.
# Get a key at: https://console.anthropic.com
ANTHROPIC_API_KEY=
